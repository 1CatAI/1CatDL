[Unit]
Description=1Cat Gaudi single-card rental control plane
After=network-online.target libvirtd.service 1cattunnel.service
Wants=network-online.target
RequiresMountsFor=/mnt/nvme1/1cat-rental-data

[Service]
Type=simple
User=root
WorkingDirectory=/opt/1cat-rental
EnvironmentFile=-/etc/1cat-rental/rental.env
ExecStart=/usr/bin/python3 /opt/1cat-rental/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/1cat-rental /mnt/nvme1/1cat-rental-data -/mnt/nvme1/1cat-rental-system

[Install]
WantedBy=multi-user.target
