RENTAL_PORT=8765
RENTAL_ROOT=/var/lib/1cat-rental
# Optional override for adminctl; otherwise it resolves to $RENTAL_ROOT/state.
RENTAL_STATE_ROOT=/var/lib/1cat-rental/state
RENTAL_STATIC_ROOT=/opt/1cat-rental/public
RENTAL_BASE_IMAGE=/var/lib/1cat-rental/images/gaudi-ubuntu24.04.qcow2
RENTAL_DATA_ROOT=/mnt/nvme1/1cat-rental-data
# Enable these together ONLY after storage_migrate.py has verified all vda paths.
# RENTAL_SYSTEM_ROOT=/mnt/nvme1/1cat-rental-system
# RENTAL_BASE_IMAGE=/mnt/nvme1/1cat-rental-images/gaudi-ubuntu24.04-repaired-20260919.qcow2
# RENTAL_STORAGE_POOL_BUDGET_GIB=3000
RENTAL_STORAGE_SAFETY_GIB=128
# Optional host-enforced virtio-fs export; enable only after host/image acceptance.
# The live host uses a separate systemd EnvironmentFile drop-in to preserve
# the original billing, networking and credential configuration.
# RENTAL_SHARED_STORAGE_CONFIG=/etc/1cat-rental/shared-storage.json
RENTAL_IMAGE_ENABLED=0
RENTAL_LIBVIRT_NETWORK=1cat-rental
RENTAL_PUBLIC_HOST=dx.1catai.com
# GPU mode is fixed at 16 vCPU, decimal 62.5 GB (62,500 MB) RAM and a
# 50 GiB system disk. All data-disk capacity is optional and billable.
# Headless mode: 2 vCPU, decimal 4 GB (4,000 MB), no GPU, 8 cents/hour.
# Independent SSH endpoints 9..24, bound locally on 2229..2244.
# Configure RENTAL_PUBLIC_PORT_9 .. RENTAL_PUBLIC_PORT_24 after tunnel setup.
# Capacity is also bounded by the shared CPU/RAM budgets; no per-user limit.
RENTAL_HEADLESS_COUNT=16
RENTAL_CPU_BUDGET=128
RENTAL_MEMORY_BUDGET_MB=500000
RENTAL_SYSTEM_DISK_BUDGET_GIB=700
RENTAL_DATA_DISK_BUDGET_GIB=3300
# Extra data disk uses the existing 70%-discounted AutoDL reference rate and
# is settled while the instance is retained.
# Set a positive integer (CNY cents/hour) before enabling paid billing.
RENTAL_RATE_CENTS_PER_HOUR=0
# Configure these only after choosing the dedicated administrator credentials.
RENTAL_ADMIN_USER=
RENTAL_ADMIN_PASSWORD=
RENTAL_ALLOW_ANONYMOUS=0
# Fill these only after 1cattunnel reports the assigned public ports.
RENTAL_PUBLIC_PORT_1=
RENTAL_PUBLIC_PORT_2=
RENTAL_PUBLIC_PORT_3=
RENTAL_PUBLIC_PORT_4=
RENTAL_PUBLIC_PORT_5=
RENTAL_PUBLIC_PORT_6=
RENTAL_PUBLIC_PORT_7=
RENTAL_PUBLIC_PORT_8=
