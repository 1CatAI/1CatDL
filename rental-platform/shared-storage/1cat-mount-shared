#!/bin/sh
# Managed by 1Cat shared-storage v1
set -eu
tag=onecat-public
target=/shared
share_alias() {
    # Never replace a customer-created /share directory or symlink.
    if [ ! -e /share ] && [ ! -L /share ]; then ln -s /shared /share; fi
}
modprobe -q virtiofs
# The image can also boot without the optional filesystem device.
found=0
for device in /sys/bus/virtio/drivers/virtiofs/virtio*; do
    if [ -e "$device" ]; then found=1; break; fi
done
[ "$found" = 1 ] || exit 0
[ ! -L "$target" ] || { echo '/shared must not be a symlink' >&2; exit 1; }
if mountpoint -q "$target"; then
    [ "$(findmnt -rn -M "$target" -o FSTYPE)" = virtiofs ]
    [ "$(findmnt -rn -M "$target" -o SOURCE)" = "$tag" ]
    findmnt -rn -M "$target" -o OPTIONS | grep -Eq '(^|,)ro(,|$)'
    share_alias
    exit 0
fi
if [ -d "$target" ] && [ -n "$(find "$target" -mindepth 1 -maxdepth 1 -print -quit)" ]; then
    echo '/shared is not empty; refusing to hide customer files' >&2
    exit 1
fi
install -d -m 0755 "$target"
mount -t virtiofs -o ro,nosuid,nodev "$tag" "$target"
share_alias
